{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format","schemaVersion","schoolId","revision","periods"],
  "properties": {
    "format": {"const":"SKTJF-VACATIONS"},
    "schemaVersion": {"const":1},
    "schoolId": {"const":"nittc"},
    "revision": {"type":"string","pattern":"^[0-9]{4}\\.[SF]\\.(0|[1-9][0-9]{0,127})(\\.Beta)?$","maxLength":1024},
    "periods": {"type":"array","maxItems":128,"items":{"$ref":"#/$defs/period"}}
  },
  "$defs": {
    "period": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","type","name","start","end","confirmedThrough","estimatedEndMonth","sources"],
      "properties":{
        "id":{"type":"string","pattern":"^[0-9]{4}-(summer|winter|year_end|spring)$"},
        "type":{"enum":["summer","winter","year_end","spring"]},
        "name":{"type":"string","minLength":1,"maxLength":128},
        "start":{"type":"string","format":"date"},
        "end":{"type":["string","null"],"format":"date"},
        "confirmedThrough":{"type":"string","format":"date"},
        "estimatedEndMonth":{"type":["integer","null"],"minimum":1,"maximum":12},
        "sources":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/source"}}
      }
    },
    "source":{
      "type":"object",
      "additionalProperties":false,
      "required":["name","sha256","url","page"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":512},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "url":{"type":["string","null"],"format":"uri","pattern":"^https://","maxLength":2048},
        "page":{"type":"integer","minimum":1}
      }
    }
  }
}
