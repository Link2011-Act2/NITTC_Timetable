{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["format","manifestVersion","schoolId","revision","asset"],
  "properties":{
    "format":{"const":"SKTJF-VACATIONS-MANIFEST"},
    "manifestVersion":{"const":1},
    "schoolId":{"const":"nittc"},
    "revision":{"type":"string","pattern":"^[0-9]{4}\\.[SF]\\.(0|[1-9][0-9]{0,127})(\\.Beta)?$","maxLength":1024},
    "asset":{
      "type":"object",
      "additionalProperties":false,
      "required":["name","url","sha256","dataFormatVersion"],
      "properties":{
        "name":{"const":"vacations.json"},
        "url":{"type":"string","format":"uri","pattern":"^https://github\\.com/","maxLength":2048},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "dataFormatVersion":{"const":1}
      }
    }
  }
}
