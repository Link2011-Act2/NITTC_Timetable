{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://link2011-act2.github.io/SKTJF/schema/sktjf-v1.schema.json",
  "title": "SKTJF version 1 class timetable",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "schoolId", "academicYear", "term", "classId", "revision", "sources", "periods", "lessons", "calendar"],
  "properties": {
    "format": {"const": "SKTJF"},
    "schemaVersion": {"const": 1},
    "schoolId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "academicYear": {"type": "integer", "minimum": 1900, "maximum": 9998},
    "term": {"type": "object", "additionalProperties": false, "required": ["code", "start", "end"], "properties": {"code": {"enum": ["S", "F"]}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}},
    "classId": {"type": "string", "pattern": "^(1-[1-4]|[2-5][MEIB]|AC-[A-Z0-9]+)$"},
    "revision": {"type": "string", "pattern": "^[0-9]{4}\\.[SF]\\.(0|[1-9][0-9]*)$"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "periods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/period"}},
    "lessons": {"type": "array", "items": {"$ref": "#/$defs/lesson"}},
    "calendar": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/day"}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "name", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["sourceId", "page"], "properties": {"sourceId": {"$ref": "#/$defs/id"}, "page": {"type": "integer", "minimum": 1}, "note": {"type": "string"}}},
    "period": {"type": "object", "additionalProperties": false, "required": ["number", "start", "end"], "properties": {"number": {"type": "integer", "minimum": 1, "maximum": 12}, "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}},
    "conditions": {"type": "object", "additionalProperties": false, "required": ["all", "none"], "properties": {"all": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "none": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "lesson": {"type": "object", "additionalProperties": false, "required": ["id", "dayOfWeek", "period", "cycle", "subject", "teachers", "rooms", "conditions", "kind", "sources"], "properties": {"id": {"$ref": "#/$defs/id"}, "dayOfWeek": {"type": "integer", "minimum": 1, "maximum": 7}, "period": {"type": "integer", "minimum": 1, "maximum": 12}, "cycle": {"enum": ["WEEKLY", "A", "B"]}, "subject": {"type": "string", "minLength": 1}, "teachers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "rooms": {"type": "array", "items": {"type": "string", "minLength": 1}}, "conditions": {"$ref": "#/$defs/conditions"}, "kind": {"enum": ["NORMAL", "MAKEUP", "EXTENSION"]}, "remote": {"type": "boolean"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}}},
    "day": {"type": "object", "additionalProperties": false, "required": ["date", "dayType", "sources"], "properties": {"date": {"type": "string", "format": "date"}, "dayType": {"enum": ["A", "B", "HOLIDAY", null]}, "overrideDayOfWeek": {"type": ["integer", "null"], "minimum": 1, "maximum": 7}, "overrideDayType": {"enum": ["A", "B", null]}, "event": {"type": ["object", "null"], "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["MIDTERM", "FINAL", "EXCURSION", "EVENT", "EXAM_RETURN", "OTHER"]}}}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}}}
  }
}
