{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://link2011-act2.github.io/NITTC_Timetable/schema/sktjf-v2.schema.json",
  "title": "SKTJF version 2 class timetable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "schoolId",
    "academicYear",
    "term",
    "classId",
    "revision",
    "sources",
    "periods",
    "slotCoverage",
    "lessons",
    "calendar"
  ],
  "properties": {
    "format": {
      "const": "SKTJF"
    },
    "schemaVersion": {
      "const": 2
    },
    "schoolId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "academicYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 9998
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "start",
        "end"
      ],
      "properties": {
        "code": {
          "enum": [
            "S",
            "F"
          ]
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "classId": {
      "type": "string",
      "pattern": "^(1-[1-4]|[2-5][MEIB]|AC-[A-Z0-9]+)$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[SF]\\.(0|[1-9][0-9]{0,127})(\\.Beta)?$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "slotCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    },
    "calendar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "weekCalendar": {
      "type": "array",
      "maxItems": 370,
      "items": {
        "$ref": "#/$defs/weekDay"
      }
    },
    "weekSeries": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/weekSeries" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "page"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "start",
        "end"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "none"
      ],
      "properties": {
        "all": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "none": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayOfWeek",
        "period",
        "state",
        "sources"
      ],
      "properties": {
        "dayOfWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "state": {
          "enum": [
            "PRESENT",
            "EMPTY",
            "EXCLUDED"
          ]
        },
        "containsExcluded": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dayOfWeek",
        "period",
        "cycle",
        "subject",
        "teachers",
        "rooms",
        "conditions",
        "kind",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "dayOfWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "cycle": {
          "enum": [
            "WEEKLY",
            "A",
            "B"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "teachers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "kind": {
          "enum": [
            "NORMAL",
            "MAKEUP",
            "EXTENSION"
          ]
        },
        "remote": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "activeWeekRange": {
          "$ref": "#/$defs/weekRange"
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "dayType",
        "sources"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "dayType": {
          "enum": [
            "A",
            "B",
            "HOLIDAY",
            null
          ]
        },
        "overrideDayOfWeek": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 7
        },
        "overrideDayType": {
          "enum": [
            "A",
            "B",
            null
          ]
        },
        "event": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "MIDTERM",
                "FINAL",
                "EXCURSION",
                "EVENT",
                "EXAM_RETURN",
                "OTHER"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "weekSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dayOfWeek", "periods", "lessonIds", "cycle", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dayOfWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
        "periods": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "lessonIds": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" } },
        "cycle": { "enum": ["WEEKLY", "A", "B"] },
        "countingPolicy": { "$ref": "#/$defs/countingPolicy" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "countingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["regularDayCounts", "holidayCounts", "eventCounts", "ordinaryPeriodCounts", "officialPeriodOverrides", "confirmedNonTeachingDates", "sources"],
      "properties": {
        "regularDayCounts": { "type": ["boolean", "null"] },
        "holidayCounts": { "type": ["boolean", "null"] },
        "eventCounts": { "type": "object", "propertyNames": { "enum": ["MIDTERM", "FINAL", "EXCURSION", "EVENT", "EXAM_RETURN", "OTHER"] },
          "additionalProperties": { "type": ["boolean", "null"] } },
        "ordinaryPeriodCounts": { "type": ["boolean", "null"] },
        "officialPeriodOverrides": { "type": "array", "maxItems": 4440, "items": {
          "type": "object", "additionalProperties": false, "required": ["date", "period", "counts"],
          "properties": { "date": { "type": "string", "format": "date" }, "period": { "type": "integer", "minimum": 1, "maximum": 12 }, "counts": { "type": ["boolean", "null"] } }
        } },
        "confirmedNonTeachingDates": { "type": "array", "maxItems": 370, "uniqueItems": true, "items": { "type": "string", "format": "date" } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "weekDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "week",
        "sources"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "weekRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "notation"
      ],
      "properties": {
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 999
        },
        "end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 999
        },
        "notation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
